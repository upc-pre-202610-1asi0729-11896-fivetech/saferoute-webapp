@startuml
skinparam monochrome false

package "stakeholder.application" {
  class StakeholderStore {
    - parentsSignal: Signal<Parent[]>
    - driversSignal: Signal<Driver[]>
    - childrenSignal: Signal<Child[]>
    - groupsSignal: Signal<StudentGroup[]>
    - stakeholderApi: StakeholderApi
    + parents: Signal<Parent[]>
    + drivers: Signal<Driver[]>
    + children: Signal<Child[]>
    + groups: Signal<StudentGroup[]>
    + loadParents(organizationId: string)
    + loadDrivers(organizationId: string)
    + loadChildren(parentId: string)
    + loadGroups(organizationId: string)
    + createParent(request: CreateParentRequest)
    + createDriver(request: CreateDriverRequest)
    + createChild(request: CreateChildRequest)
    + createGroup(request: CreateStudentGroupRequest)
    + finalizeGroup(groupId: string)
  }
}

package "stakeholder.infrastructure" {
  class StakeholderApi {
    - baseUrl: string
    - http: HttpClient
    + createParent(request: CreateParentRequest): Observable<ParentResource>
    + getParentsByOrganization(organizationId: string): Observable<ParentResource[]>
    + createDriver(request: CreateDriverRequest): Observable<DriverResource>
    + getDriversByOrganization(organizationId: string): Observable<DriverResource[]>
    + createChild(request: CreateChildRequest): Observable<ChildResource>
    + getChildrenByParent(parentId: string): Observable<ChildResource[]>
    + createStudentGroup(request: CreateStudentGroupRequest): Observable<StudentGroupResource>
    + getGroupsByOrganization(organizationId: string): Observable<StudentGroupResource[]>
    + finalizeGroup(groupId: string): Observable<StudentGroupResource>
  }
  class ParentAssembler {
    + toEntityFromResource(resource: ParentResource): Parent
    + toEntitiesFromResponse(resources: ParentResource[]): Parent[]
  }
  class DriverAssembler {
    + toEntityFromResource(resource: DriverResource): Driver
    + toEntitiesFromResponse(resources: DriverResource[]): Driver[]
  }
  class ChildAssembler {
    + toEntityFromResource(resource: ChildResource): Child
    + toEntitiesFromResponse(resources: ChildResource[]): Child[]
  }
  class StudentGroupAssembler {
    + toEntityFromResource(resource: StudentGroupResource): StudentGroup
    + toEntitiesFromResponse(resources: StudentGroupResource[]): StudentGroup[]
  }
  interface ParentResource {
    + id: string
    + fullName: string
    + email: string
    + phoneNumber: string
    + organizationId: string
  }
  interface DriverResource {
    + id: string
    + fullName: string
    + email: string
    + phoneNumber: string
    + licenseNumber: string
    + organizationId: string
  }
  interface ChildResource {
    + id: string
    + fullName: string
    + age: number
    + enrollmentState: string
    + parentId: string
  }
  interface StudentGroupResource {
    + id: string
    + name: string
    + organizationId: string
    + childIds: string[]
    + isFinalized: boolean
  }
  interface CreateParentRequest {
    + firstName: string
    + lastName: string
    + email: string
    + phoneNumber: string
    + organizationId: string
    + userId: string
  }
  interface CreateDriverRequest {
    + firstName: string
    + lastName: string
    + email: string
    + phoneNumber: string
    + licenseNumber: string
    + organizationId: string
    + userId: string
  }
  interface CreateChildRequest {
    + firstName: string
    + lastName: string
    + age: number
    + parentId: string
  }
  interface CreateStudentGroupRequest {
    + name: string
    + organizationId: string
  }
}

