package "notifications.domain.model" {
  class Notification {
  }
  class Alert {
  }
  class Announcement {
  }
}

NotificationsStore --> NotificationsApi : «uses»
NotificationsStore --> Notification : «uses»
NotificationsStore --> Alert : «uses»
NotificationsStore --> Announcement : «uses»
NotificationsApi --> NotificationAssembler : «uses»
NotificationsApi --> AlertAssembler : «uses»
NotificationsApi --> AnnouncementAssembler : «uses»
NotificationsApi ..> CreateNotificationRequest : «uses»
NotificationsApi ..> CreateAlertRequest : «uses»
NotificationsApi ..> CreateAnnouncementRequest : «uses»
NotificationsApi ..> NotificationResource : «returns»
NotificationsApi ..> AlertResource : «returns»
NotificationsApi ..> AnnouncementResource : «returns»
NotificationAssembler --> Notification : «creates»
NotificationAssembler ..> NotificationResource : «transforms»
AlertAssembler --> Alert : «creates»
AlertAssembler ..> AlertResource : «transforms»
AnnouncementAssembler --> Announcement : «creates»
AnnouncementAssembler ..> AnnouncementResource : «transforms»

@enduml
