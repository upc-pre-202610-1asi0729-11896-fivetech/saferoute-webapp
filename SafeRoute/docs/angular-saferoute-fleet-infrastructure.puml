@startuml
skinparam monochrome false

package "fleet.application" {
  class FleetStore {
    - routesSignal: Signal<Route[]>
    - stopsSignal: Signal<Stop[]>
    - vehiclesSignal: Signal<Vehicle[]>
    - assignmentsSignal: Signal<Assignment[]>
    - fleetApi: FleetApi
    + routes: Signal<Route[]>
    + stops: Signal<Stop[]>
    + vehicles: Signal<Vehicle[]>
    + assignments: Signal<Assignment[]>
    + loadRoutes(organizationId: string)
    + loadStops(routeId: string)
    + loadVehicles(organizationId: string)
    + createRoute(request: CreateRouteRequest)
    + activateRoute(id: string)
    + createVehicle(request: CreateVehicleRequest)
    + createAssignment(request: CreateAssignmentRequest)
  }
}

package "fleet.infrastructure" {
  class FleetApi {
    - baseUrl: string
    - http: HttpClient
    + createRoute(request: CreateRouteRequest): Observable<RouteResource>
    + getRoutesByOrganization(organizationId: string): Observable<RouteResource[]>
    + activateRoute(id: string): Observable<RouteResource>
    + addStop(request: CreateStopRequest): Observable<StopResource>
    + getStopsByRoute(routeId: string): Observable<StopResource[]>
    + createVehicle(request: CreateVehicleRequest): Observable<VehicleResource>
    + getVehiclesByOrganization(organizationId: string): Observable<VehicleResource[]>
    + createAssignment(request: CreateAssignmentRequest): Observable<AssignmentResource>
    + getAssignmentByRoute(routeId: string): Observable<AssignmentResource>
  }
  class RouteAssembler {
    + toEntityFromResource(resource: RouteResource): Route
    + toEntitiesFromResponse(resources: RouteResource[]): Route[]
  }
  class StopAssembler {
    + toEntityFromResource(resource: StopResource): Stop
    + toEntitiesFromResponse(resources: StopResource[]): Stop[]
  }
  class VehicleAssembler {
    + toEntityFromResource(resource: VehicleResource): Vehicle
    + toEntitiesFromResponse(resources: VehicleResource[]): Vehicle[]
  }
  class AssignmentAssembler {
    + toEntityFromResource(resource: AssignmentResource): Assignment
  }
  interface RouteResource {
    + id: string
    + name: string
    + organizationId: string
    + routeState: string
    + departureTime: string
    + serviceDays: string[]
    + vehicleId: string
  }
  interface StopResource {
    + id: string
    + routeId: string
    + name: string
    + latitude: number
    + longitude: number
    + stopOrder: number
  }
  interface VehicleResource {
    + id: string
    + organizationId: string
    + plate: string
    + model: string
    + brand: string
    + capacity: number
  }
  interface AssignmentResource {
    + id: string
    + routeId: string
    + driverId: string
    + childIds: string[]
  }
  interface CreateRouteRequest {
    + name: string
    + organizationId: string
    + departureTime: string
    + serviceDays: string[]
  }
  interface CreateStopRequest {
    + routeId: string
    + name: string
    + latitude: number
    + longitude: number
    + stopOrder: number
  }
  interface CreateVehicleRequest {
    + organizationId: string
    + plate: string
    + model: string
    + brand: string
    + capacity: number
  }
  interface CreateAssignmentRequest {
    + routeId: string
    + driverId: string
    + childIds: string[]
  }
}

