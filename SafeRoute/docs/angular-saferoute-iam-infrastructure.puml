@startuml
skinparam monochrome false

package "iam.application" {
  class IamStore {
    - currentUserSignal: Signal<User>
    - organizationSignal: Signal<Organization>
    - iamApi: IamApi
    + currentUser: Signal<User>
    + organization: Signal<Organization>
    + isAuthenticated: Signal<boolean>
    + signIn(email: string, password: string)
    + signOut()
    + registerAdmin(request: RegisterUserRequest)
    + loadOrganization(id: string)
    + createOrganization(request: CreateOrganizationRequest)
  }
}

package "iam.infrastructure" {
  class IamApi {
    - baseUrl: string
    - http: HttpClient
    + signIn(email: string, password: string): Observable<SignInResponse>
    + registerUser(request: RegisterUserRequest): Observable<UserResource>
    + createOrganization(request: CreateOrganizationRequest): Observable<OrganizationResource>
    + getOrganizationById(id: string): Observable<OrganizationResource>
  }
  class UserAssembler {
    + toEntityFromResource(resource: UserResource): User
    + toEntitiesFromResponse(resources: UserResource[]): User[]
  }
  class OrganizationAssembler {
    + toEntityFromResource(resource: OrganizationResource): Organization
  }
  interface UserResource {
    + id: string
    + fullName: string
    + email: string
    + roleTier: string
    + organizationId: string
  }
  interface OrganizationResource {
    + id: string
    + name: string
    + status: string
    + createdAt: string
  }
  interface RegisterUserRequest {
    + firstName: string
    + lastName: string
    + email: string
    + password: string
    + roleTier: string
    + organizationId: string
  }
  interface CreateOrganizationRequest {
    + name: string
  }
  interface SignInResponse {
    + token: string
    + userId: string
    + roleTier: string
  }
}

