  class Trip {
  }
  class Attendance {
  }
  class Incident {
  }
}

TripStore --> TripApi : «uses»
TripStore --> Trip : «uses»
TripStore --> Attendance : «uses»
TripStore --> Incident : «uses»
TripApi --> TripAssembler : «uses»
TripApi --> AttendanceAssembler : «uses»
TripApi --> IncidentAssembler : «uses»
TripApi ..> StartTripRequest : «uses»
TripApi ..> UpdateBoardingRequest : «uses»
TripApi ..> ReportIncidentRequest : «uses»
TripApi ..> TripResource : «returns»
TripApi ..> AttendanceResource : «returns»
TripApi ..> IncidentResource : «returns»
TripAssembler --> Trip : «creates»
